{
  "schemaVersion": 1,
  "hubApi": 1,
  "id": "copyall",
  "version": "1.1.1",
  "platform": "win-x64",
  "ui": "ui/index.html",
  "worker": {
    "executable": "worker/CopyAll.Worker.exe",
    "arguments": []
