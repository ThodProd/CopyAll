<Window x:Class="CopyAll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка контекстного меню" Height="274" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8F9FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите действие:" 
                   FontSize="16" FontWeight="SemiBold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button Content="Установить в контекстное меню" 
                    Width="260" Height="42" Margin="0,0,0,12" 
                    FontSize="14" Click="BtnInstall_Click"/>

            <Button Content="Удалить из контекстного меню" 
                    Width="260" Height="42" 
                    FontSize="14" Click="BtnRemove_Click"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Закрыть" Width="90" Height="32" 
                HorizontalAlignment="Right" Click="BtnClose_Click"/>
    </Grid>
</Window>